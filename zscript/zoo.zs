// Heavier balls for the big animals, a stinging ball for the flyers, and a header that curls after you.
class SICBigBall : SICEnemyBall
{
	Default
	{
		Speed 18;
		Scale 0.45;
		DamageFunction (random(2, 8) * 4);
		Translation "0:255=%[0.1,0.1,0.25]:[1.0,1.2,2.0]";
	}
}

class SICStingBall : SICEnemyBall
{
	Default
	{
		Speed 22;
		Gravity 0;
		Scale 0.25;
		DamageFunction (random(2, 6) * 3);
		Translation "0:255=%[0.25,0.2,0.0]:[2.0,1.8,0.4]";
	}
}

class SICHeaderBall : SICEnemyBall
{
	Default
	{
		Speed 12;
		Gravity 0;
		+SEEKERMISSILE
		DamageFunction (random(1, 8) * 6);
		Translation "0:255=%[0.25,0.15,0.0]:[2.0,1.6,0.6]";
	}
	override void PostBeginPlay()
	{
		Super.PostBeginPlay();
		if (target) tracer = target.target;
	}
	override void Tick()
	{
		Super.Tick();
		if (bDestroyed || isFrozen()) return;
		if (level.maptime % 3 == 0) A_SeekerMissile(4, 6);
		if (level.maptime % 2 == 0) SICCube.Make(pos, 'G', 0.25, (0, 0, 0), 10, 0);
	}
}
