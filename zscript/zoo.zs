// Generated by gen/tools/make_zoo.py: the rest of Doom's bestiary as Grey Matter FC's animal players.
// Each keeps the health, size and job of the monster it replaces (the parrot spits chicks like the Pain Elemental,
// the chick charges like a Lost Soul, the lion fires TNT like the Cyberdemon), and wears the purple team band.

class SICCow : SICFooty replaces HellKnight
{
	Default
	{
		Health 500;
		Speed 8;
		Radius 24;
		Height 64;
		Mass 1000;
		PainChance 50;
		Tag "Cow Defender";
		Obituary "%o was outplayed by the Cow Defender.";
	}
	States
	{
	Spawn:
		SCOW A 10 A_Look;
		SCOW C 10 A_Look;
		Loop;
	See:
		SCOW ABCD 3 A_Chase;
		Loop;
	Missile:
		SCOW E 8 A_FaceTarget;
		SCOW F 6 A_KickAt("SICBigBall");
		SCOW E 6;
		Goto See;
	Pain:
		SCOW G 3;
		SCOW G 3 A_Pain;
		Goto See;
	Death:
		SCOW H 4 A_Scream;
		SCOW I 4 A_NoBlocking;
		SCOW J 4;
		SCOW K 30;
		SCOW K 1 A_Vanish;
		Stop;
	XDeath:
		SCOW H 3 A_Shatter;
		SCOW I 3 A_NoBlocking;
		SCOW JK 3;
		SCOW K 1 A_Vanish;
		Stop;
	}
}

